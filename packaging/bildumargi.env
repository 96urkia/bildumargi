# Ajustes de Bildumargi (paquete .deb). Tras cambiarlos:
#   sudo systemctl restart bildumargi
#
# Las claves NO van aquí: van en /etc/bildumargi/secretos.env, que solo puede
# leer el administrador del sistema.

# Dirección y puerto. 127.0.0.1 = solo desde este servidor (lo normal si se
# publica detrás de nginx). 0.0.0.0 = desde cualquier equipo de la red.
BILDUMARGI_HOST=127.0.0.1
BILDUMARGI_PUERTO=8765

# Carpeta de datos: bases de datos, historial de cada biblioteca, DILVE...
BILDUMARGI_DATOS=/var/lib/bildumargi
